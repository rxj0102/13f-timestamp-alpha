# ─────────────────────────────────────────────
# Raw EDGAR data (large; regenerated by scraper)
# ─────────────────────────────────────────────
data/raw/filings/*.xml
data/raw/filings/*.json
data/raw/filings/*.sgml
data/raw/filings/*.txt

# ─────────────────────────────────────────────
# Processed data (regenerated by pipeline)
# ─────────────────────────────────────────────
data/processed/*.parquet
data/processed/*.csv
data/processed/*.json

# ─────────────────────────────────────────────
# Outputs (charts, CSVs — regenerated)
# ─────────────────────────────────────────────
outputs/*.png
outputs/*.csv
outputs/*.pdf
outputs/*.html

# ─────────────────────────────────────────────
# IDE / editor
# ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────
# Secrets & credentials (NEVER commit)
# ─────────────────────────────────────────────
.env
*.env
secrets.yaml
credentials.json

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
*.log
logs/

# ─────────────────────────────────────────────
# Do NOT ignore data/reference/ — reference CSVs are versioned
# ─────────────────────────────────────────────
!data/reference/
!data/reference/*.csv
